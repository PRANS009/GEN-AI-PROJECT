# Copy to .env.local for a hosted Supabase project.
NEXT_PUBLIC_APP_NAME="SQL Studio AI"
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only after configuring the GitHub provider in Supabase Auth.
STUDIO_GITHUB_AUTH=false
# Later AI integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Server-only service role key for persistent activity logging & admin monitoring
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated list of administrator emails (optional alongside profiles.role='admin')
ADMIN_EMAILS=
